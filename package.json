    "release": "npm run build && npm test",
    "check:release": "node scripts/check-release.cjs"
  },
  "devDependencies": {
    "javascript-obfuscator": "4.1.1",
    "terser": "5.44.1"
  },
  "author": "elsebit",
  "repository": {
    "type": "git",
    "url": "https://github.com/elsebit/nested-iframe-dom-exporter.git"
