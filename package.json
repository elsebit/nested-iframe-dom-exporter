{
  "name": "nested-iframe-dom-exporter",
  "version": "0.14.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Standalone userscript to export a page and readable nested iframe DOM",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "check:artifacts": "node scripts/build.cjs --check",
